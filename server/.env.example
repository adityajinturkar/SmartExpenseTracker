# Copy this file to .env in the server/ directory.
# Replace every placeholder with your own value. Never commit the real .env file.

PORT=5000
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/<database-name>?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret
OPENROUTER_API_KEY=your_openrouter_api_key
RESEND_API_KEY=your_resend_api_key
CLIENT_URL=http://localhost:5173
